# Data: the release is tracked (a few MB); the FASTA copy and the download cache are rebuilt by
# scripts/build_dsni.py. List every tracked file explicitly.
data/*
!data/.gitkeep
!data/README.md
!data/dsni.parquet
!data/dsni_sample.parquet
!data/manifest.json
!data/media_map.csv
!data/media_compositions.json

# Regenerable outputs
out/*
!out/.gitkeep
lightning_logs/
*.ckpt

# The two small demo models are shipped so the demo's result is the same on every machine
!checkpoints/
!checkpoints/transformer_flat.ckpt
!checkpoints/transformer_gated.ckpt

# Agent scratch and local guidance
.claude/
CLAUDE.md
